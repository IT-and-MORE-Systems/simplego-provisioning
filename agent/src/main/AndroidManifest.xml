  SimpleGo Provisioning attestation agent. No permissions, no activities, no
  UI, and no package visibility: it sees no other app. It runs only as an
  instrumentation started by `sxprov` over adb and is uninstalled afterwards.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="sxprov agent" />

    <instrumentation
        android:name=".AttestInstrumentation"
        android:label="sxprov attestation agent"
        android:targetPackage="${applicationId}" />

</manifest>
